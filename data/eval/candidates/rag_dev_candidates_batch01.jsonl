{"schema_version":"rag-eval-v2","case_id":"rag_dev_candidate_b01_005","split":"candidate","scenario_type":"cross_policy","difficulty":"hard","context_mode":"explicit","query":"平台已经受理了我升级投诉的请求，我要求把订单款全退给我。接下来平台依据什么决定能不能退？","input_context":{"primary_intent":"return_refund","topic":"refund_eligibility","related_topics":["complaint"]},"expected":{"primary_targets":[{"source":"投诉升级SOP.md","sections":["处理原则"]}],"supporting_targets":[],"evidence_requirements":[{"evidence_type":"complaint_escalation","acceptable_sources":["投诉升级SOP.md"],"acceptable_sections":["处理原则"],"keywords_all":["投诉升级不代表用户提出的要求一定成立"]},{"evidence_type":"complaint_escalation","acceptable_sources":["投诉升级SOP.md"],"acceptable_sections":["处理原则"],"keywords_all":["根据订单事实、平台政策以及人工审核结果决定"]},{"evidence_type":"refund_risk_review","acceptable_sources":["退款政策.md"],"acceptable_sections":["退款人工审核"],"keywords_all":["以下情况可能进入人工审核","投诉升级并涉及资金操作"]},{"evidence_type":"refund_eligibility","acceptable_sources":["退款政策.md"],"acceptable_sections":["退款资格判断"],"keywords_all":["只有满足对应退款条件后，才能继续进入退款申请流程"]}]},"tags":["refund"],"notes":"投诉升级与资金请求的联合证据；受理不等于诉求成立，不预设审核结果。"}
