+    prefix = f"退款申请 {refund.get('refund_id')}"
+    messages = {
+        "queued": "已受理，正在等待处理。申请受理不代表资金已经退回。",
+        "pending_manual_review": "当前状态为待人工审核。",
+        "refund_processing": "正在处理中，尚未确认处理完成。",
