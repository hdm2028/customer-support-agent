APP_NAME=中文电商智能售后客服 Agent

# 智谱 Chat Completions
LLM_API_KEY=replace-with-your-zhipu-api-key
LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash

# 智谱 Embedding。部署演示如果想降低外部依赖，也可以改成 local。
RAG_EMBEDDING_PROVIDER=zhipu
ZHIPU_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
ZHIPU_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

# SQLite 数据库路径。只有 DATABASE_BACKEND=sqlite 时才会使用。
DATABASE_PATH=data/customer_support.db

# 本机 MySQL。可以只填 MYSQL_DSN，也可以使用下面的拆分配置。
DATABASE_BACKEND=mysql
MYSQL_DSN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=customer_support
MYSQL_PASSWORD=customer_support_pass
MYSQL_DATABASE=customer_support
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
# 本机 MySQL 已迁移真实数据时保持 false，避免启动时覆盖订单种子。
SEED_DEMO_DATA=false

# Hybrid RAG: vector recall + BM25 recall + business keyword recall + business rerank.
RAG_SEMANTIC_WEIGHT=0.62
RAG_BM25_WEIGHT=0.28
RAG_KEYWORD_WEIGHT=0.10
RAG_CANDIDATE_MULTIPLIER=4
EMBEDDING_CACHE_TTL_SECONDS=86400

# 本机 Redis。可以只填 REDIS_URL，也可以使用下面的拆分配置。
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
AGENT_STATE_TTL_SECONDS=1800

# MQ：当前退款异步消息保存在业务数据库，后续可替换 RabbitMQ/Kafka。
MQ_BACKEND=database

# 高并发退款控制：同一订单并发退款请求只允许一个创建，其余请求复用幂等结果。
REFUND_LOCK_TTL_SECONDS=15
REFUND_LOCK_WAIT_SECONDS=3
REFUND_IDEMPOTENCY_TTL_SECONDS=86400

LLM_TIMEOUT_SECONDS=60
