APP_NAME=中文电商智能售后客服 Agent

# LLM
LLM_API_KEY=
LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash
LLM_TIMEOUT_SECONDS=60

# Embedding
RAG_EMBEDDING_PROVIDER=local
ZHIPU_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
ZHIPU_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CACHE_TTL_SECONDS=86400

# Database
DATABASE_BACKEND=mysql
DATABASE_PATH=data/customer_support.db
MYSQL_DSN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=customer_support
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=customer_support
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
SEED_DEMO_DATA=false

# Redis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
AGENT_STATE_TTL_SECONDS=1800

# Tool runtime reliability
TOOL_ORDER_LOOKUP_TIMEOUT_SECONDS=3
TOOL_POLICY_SEARCH_TIMEOUT_SECONDS=8
TOOL_RISK_CHECK_TIMEOUT_SECONDS=4
TOOL_REFUND_APPLY_TIMEOUT_SECONDS=8
TOOL_CREATE_TICKET_TIMEOUT_SECONDS=5
TOOL_CREATE_MANUAL_REVIEW_TIMEOUT_SECONDS=5
TOOL_TRANSFER_TO_HUMAN_TIMEOUT_SECONDS=2
TOOL_RETRY_BACKOFF_SECONDS=0.1
TOOL_TIMEOUT_WORKER_LIMIT=16

# MQ
MQ_BACKEND=database

# RAG ranking
RAG_SEMANTIC_WEIGHT=0.62
RAG_BM25_WEIGHT=0.28
RAG_KEYWORD_WEIGHT=0.10
RAG_CANDIDATE_MULTIPLIER=4
RAG_RANKING_MODE=hybrid_rule
RAG_SEMANTIC_RERANKER_PROVIDER=cross_encoder
RAG_SEMANTIC_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_SEMANTIC_RERANKER_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RAG_SEMANTIC_RERANKER_DEVICE=cpu
RAG_SEMANTIC_RERANKER_BATCH_SIZE=8
RAG_SEMANTIC_RERANKER_MAX_LENGTH=512

# Refund concurrency
REFUND_LOCK_TTL_SECONDS=15
REFUND_LOCK_WAIT_SECONDS=3
REFUND_IDEMPOTENCY_TTL_SECONDS=86400
